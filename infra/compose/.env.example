# Copy to .env. Generate three DIFFERENT random passwords before starting.
# Secrets intentionally have no defaults. Do not commit .env or config output.
POSTGRES_DB=ttcp
POSTGRES_USER=ttcp
POSTGRES_PASSWORD=
REDIS_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
HTTP_PORT=8080
GRAFANA_PORT=3000
VM_RETENTION=7d
TTCP_LOG_LEVEL=INFO
# Required by the monitoring collector and for auth/encrypted SSH identities.
# API, worker, and collector must receive the same key; back it up separately from PostgreSQL.
# Generate a Fernet key and store it only in protected .env/runtime environment.
TTCP_AUTH_ENCRYPTION_KEY=
TTCP_AUTH_SESSION_SECONDS=28800
# Optional runtime login, provisioned separately; set BOTH values.
# POSTGRES_APP_USER=ttcp_app
# POSTGRES_APP_PASSWORD=
