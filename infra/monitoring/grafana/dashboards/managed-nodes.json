{
  "uid": "ttcp-managed-nodes",
  "title": "TrustTunnel managed nodes",
  "tags": ["trusttunnel"],
  "schemaVersion": 41,
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "30s",
  "templating": {"list": [{"name": "server_id", "type": "query", "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "query": "label_values(ttcp_server_info, server_id)", "refresh": 1, "includeAll": true, "multi": true}]},
  "panels": [
    {"id": 1, "title": "Server inventory and Control Plane status", "type": "table", "gridPos": {"x": 0, "y": 0, "w": 24, "h": 6}, "targets": [{"expr": "ttcp_server_info{server_id=~\"$server_id\"}", "instant": true, "refId": "A"}]},
    {"id": 2, "title": "Managed-node scrape availability", "type": "timeseries", "gridPos": {"x": 0, "y": 6, "w": 12, "h": 7}, "targets": [{"expr": "ttcp_node_scrape_success{server_id=~\"$server_id\"}", "legendFormat": "{{server_id}}", "refId": "A"}]},
    {"id": 3, "title": "Collector availability", "type": "timeseries", "gridPos": {"x": 12, "y": 6, "w": 12, "h": 7}, "targets": [{"expr": "up{job=\"ttcp-managed-nodes\"}", "refId": "A"}]},
    {"id": 4, "title": "CPU utilization", "type": "timeseries", "gridPos": {"x": 0, "y": 13, "w": 12, "h": 7}, "targets": [{"expr": "100 * (1 - avg by (server_id) (rate(node_cpu_seconds_total{mode=\"idle\",server_id=~\"$server_id\"}[5m])))", "legendFormat": "{{server_id}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}}},
    {"id": 5, "title": "Memory utilization", "type": "timeseries", "gridPos": {"x": 12, "y": 13, "w": 12, "h": 7}, "targets": [{"expr": "100 * (1 - node_memory_MemAvailable_bytes{server_id=~\"$server_id\"} / node_memory_MemTotal_bytes{server_id=~\"$server_id\"})", "legendFormat": "{{server_id}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}}},
    {"id": 6, "title": "Load (1m / 5m / 15m)", "type": "timeseries", "gridPos": {"x": 0, "y": 20, "w": 12, "h": 7}, "targets": [{"expr": "node_load1{server_id=~\"$server_id\"}", "legendFormat": "{{server_id}} 1m", "refId": "A"}, {"expr": "node_load5{server_id=~\"$server_id\"}", "legendFormat": "{{server_id}} 5m", "refId": "B"}, {"expr": "node_load15{server_id=~\"$server_id\"}", "legendFormat": "{{server_id}} 15m", "refId": "C"}]},
    {"id": 7, "title": "Uptime", "type": "timeseries", "gridPos": {"x": 12, "y": 20, "w": 12, "h": 7}, "targets": [{"expr": "time() - node_boot_time_seconds{server_id=~\"$server_id\"}", "legendFormat": "{{server_id}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 8, "title": "Filesystem used", "type": "timeseries", "gridPos": {"x": 0, "y": 27, "w": 12, "h": 7}, "targets": [{"expr": "100 * (1 - node_filesystem_avail_bytes{server_id=~\"$server_id\",fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{server_id=~\"$server_id\",fstype!~\"tmpfs|overlay|squashfs\"})", "legendFormat": "{{server_id}} {{mountpoint}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}}},
    {"id": 9, "title": "Disk read / write", "type": "timeseries", "gridPos": {"x": 12, "y": 27, "w": 12, "h": 7}, "targets": [{"expr": "rate(node_disk_read_bytes_total{server_id=~\"$server_id\"}[5m])", "legendFormat": "{{server_id}} {{device}} read", "refId": "A"}, {"expr": "rate(node_disk_written_bytes_total{server_id=~\"$server_id\"}[5m])", "legendFormat": "{{server_id}} {{device}} write", "refId": "B"}], "fieldConfig": {"defaults": {"unit": "Bps"}}},
    {"id": 10, "title": "Network RX / TX", "type": "timeseries", "gridPos": {"x": 0, "y": 34, "w": 12, "h": 7}, "targets": [{"expr": "rate(node_network_receive_bytes_total{server_id=~\"$server_id\",device!=\"lo\"}[5m])", "legendFormat": "{{server_id}} {{device}} RX", "refId": "A"}, {"expr": "rate(node_network_transmit_bytes_total{server_id=~\"$server_id\",device!=\"lo\"}[5m])", "legendFormat": "{{server_id}} {{device}} TX", "refId": "B"}], "fieldConfig": {"defaults": {"unit": "Bps"}}},
    {"id": 11, "title": "Network packets", "type": "timeseries", "gridPos": {"x": 12, "y": 34, "w": 12, "h": 7}, "targets": [{"expr": "rate(node_network_receive_packets_total{server_id=~\"$server_id\",device!=\"lo\"}[5m])", "legendFormat": "{{server_id}} {{device}} RX", "refId": "A"}, {"expr": "rate(node_network_transmit_packets_total{server_id=~\"$server_id\",device!=\"lo\"}[5m])", "legendFormat": "{{server_id}} {{device}} TX", "refId": "B"}]},
    {"id": 12, "title": "Network errors and drops", "type": "timeseries", "gridPos": {"x": 0, "y": 41, "w": 24, "h": 7}, "targets": [{"expr": "rate(node_network_receive_errs_total{server_id=~\"$server_id\",device!=\"lo\"}[5m]) + rate(node_network_receive_drop_total{server_id=~\"$server_id\",device!=\"lo\"}[5m])", "legendFormat": "{{server_id}} {{device}} RX", "refId": "A"}, {"expr": "rate(node_network_transmit_errs_total{server_id=~\"$server_id\",device!=\"lo\"}[5m]) + rate(node_network_transmit_drop_total{server_id=~\"$server_id\",device!=\"lo\"}[5m])", "legendFormat": "{{server_id}} {{device}} TX", "refId": "B"}]},
    {"id": 13, "title": "Interface utilization", "type": "timeseries", "gridPos": {"x": 0, "y": 48, "w": 24, "h": 7}, "targets": [{"expr": "100 * rate(node_network_receive_bytes_total{server_id=~\"$server_id\",device!=\"lo\"}[5m]) / node_network_speed_bytes{server_id=~\"$server_id\",device!=\"lo\"}", "legendFormat": "{{server_id}} {{device}} RX", "refId": "A"}, {"expr": "100 * rate(node_network_transmit_bytes_total{server_id=~\"$server_id\",device!=\"lo\"}[5m]) / node_network_speed_bytes{server_id=~\"$server_id\",device!=\"lo\"}", "legendFormat": "{{server_id}} {{device}} TX", "refId": "B"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0}}},
    {"id": 14, "title": "TrustTunnel service state", "type": "table", "gridPos": {"x": 0, "y": 55, "w": 12, "h": 6}, "targets": [{"expr": "ttcp_service_state_info{server_id=~\"$server_id\"}", "instant": true, "refId": "A"}]},
    {"id": 15, "title": "TrustTunnel running version", "type": "table", "gridPos": {"x": 12, "y": 55, "w": 12, "h": 6}, "targets": [{"expr": "ttcp_service_running_version_info{server_id=~\"$server_id\"}", "instant": true, "refId": "A"}]},
    {"id": 16, "title": "TrustTunnel service / process / probe", "type": "timeseries", "gridPos": {"x": 0, "y": 61, "w": 12, "h": 7}, "targets": [{"expr": "ttcp_service_active{server_id=~\"$server_id\"}", "legendFormat": "{{server_id}} service", "refId": "A"}, {"expr": "ttcp_process_running{server_id=~\"$server_id\"}", "legendFormat": "{{server_id}} process", "refId": "B"}, {"expr": "ttcp_service_probe_success{server_id=~\"$server_id\"}", "legendFormat": "{{server_id}} probe", "refId": "C"}]},
    {"id": 17, "title": "TrustTunnel automatic restart count", "type": "timeseries", "gridPos": {"x": 12, "y": 61, "w": 12, "h": 7}, "targets": [{"expr": "ttcp_service_automatic_restarts_total{server_id=~\"$server_id\"}", "legendFormat": "{{server_id}}", "refId": "A"}]}
  ]
}
